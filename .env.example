# ==============================
# OnePower Web/API - .env.example
# Supabase-first migration template
# ==============================

# App
NODE_ENV=development
PORT=4000
BASE_URL=/
PUBLIC_HOST=http://localhost:4000/api

# Auth/session (legacy + transition)
SESSION_SECRET_KEY=replace-with-long-random-secret
JWT_SECRET_KEY=replace-with-long-random-secret

# License/verification (current app behavior)
VERIFICATION_ENCRYPTION_KEY=replace-with-32-byte-key

# ------------------------------
# Supabase (target stack)
# ------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional direct Postgres connection
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_SSL=true

# Provider toggles for staged migration
AUTH_PROVIDER=supabase
DATA_PROVIDER=supabase
STORAGE_PROVIDER=supabase
PUSH_PROVIDER=firebase

# Supabase Storage
SUPABASE_STORAGE_BUCKET_PUBLIC=public-assets
SUPABASE_STORAGE_BUCKET_PRIVATE=private-assets
SUPABASE_SIGNED_URL_TTL_SECONDS=900

# ------------------------------
# Firebase (keep for push during migration)
# ------------------------------
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", "project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-firebase-bucket.appspot.com

# Legacy Firebase vars still used in some places
firebase_projectId=
firebase_client_email=
firebase_private_key=
firebase_private_key_id=
firebase_client_id=
firebase_auth_uri=
firebase_token_uri=
firebase_auth_provider_x509_cert_url=
firebase_client_x509_cert_url=
firebase_universe_domain=

# ------------------------------
# Payments (Paystack only)
# ------------------------------
PAYSTACK_MODE=test
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ------------------------------
# Email
# ------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
SENDER_EMAIL=notifications@yourdomain.com

# ------------------------------
# Monitoring
# ------------------------------
NEW_RELIC_APP_NAME=onepower-web-dashboard
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_LOG_LEVEL=info
