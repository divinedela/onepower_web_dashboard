# Core runtime
NODE_ENV=development
PORT=4000
BASE_URL=/
PUBLIC_HOST=https://api.example.com/api
SESSION_SECRET_KEY=change-me
LOG_LEVEL=info

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Must be an HTTPS callback URL registered in Supabase Auth settings
SUPABASE_AUTH_REDIRECT_URL=https://onepower.app/auth-callback

# Paystack (unchanged)
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=paystack_webhook_secret

# Firebase push (unchanged)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account"}
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket

# Optional media host
IMAGE_URL=https://cdn.example.com/uploads/
