<%- include('../layouts/header.ejs') %>

<div class="d-flex flex-column flex-root" id="kt_app_root">
  <div class="d-flex flex-column flex-lg-row flex-column-fluid">
    <div class="d-flex flex-column flex-lg-row-auto bg-primary-info w-xl-600px positon-xl-relative">
      <div class="d-flex flex-column position-xl-fixed top-0 bottom-0 w-xl-600px scroll-y">
        <div class="d-flex flex-row-fluid flex-column text-center p-5 p-lg-10 pt-lg-20">
          <a class="py-2 py-lg-20">
            <img alt="Logo" src="assets/media/logos/image.png" class="h-90px h-lg-100px" />
          </a>
          <h1 class="d-none d-lg-block fw-bold text-white fs-2x pb-5 pb-md-10">
            Set a new password
          </h1>
          <p class="d-none d-lg-block fw-semibold fs-3 text-white">
            This page works with the reset link sent to your email.
          </p>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column flex-lg-row-fluid py-10">
      <div class="d-flex flex-center flex-column flex-column-fluid">
        <div class="card">
          <div class="w-lg-600px p-10 p-lg-15 mx-auto">
            <form class="form w-100" method="post" id="resetForm">
              <div class="text-center mb-10">
                <h1 class="text-dark mb-3">Reset password</h1>
                <div class="text-gray-500 fw-semibold" id="tokenStatus">Validating link…</div>
              </div>

              <% if(flash.error.length> 0){ %>
              <div class="alert alert-dismissible bg-light-danger d-flex align-items-center mb-10">
                <span class="fs-6 text-danger fw-bold text-center ps-5 fw-bolder"><%= flash.error %></span>
                <button type="button" class="btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                  <i class="ki-duotone ki-cross fs-1 text-danger fw-bold"><span class="path1"></span><span class="path2"></span></i>
                </button>
              </div>
              <% } %>

              <% if(flash.success.length> 0){ %>
              <div class="alert alert-dismissible bg-light-success d-flex align-items-center mb-10">
                <span class="fs-6 text-success fw-bold text-center ps-5 fw-bolder"><%= flash.success %></span>
                <button type="button" class="btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                  <i class="ki-duotone ki-cross fs-1 text-success fw-bold"><span class="path1"></span><span class="path2"></span></i>
                </button>
              </div>
              <% } %>

              <input type="hidden" name="access_token" id="accessTokenInput" value="<%= accessToken %>" />

              <div class="mb-10 fv-row" data-kt-password-meter="true">
                <label class="form-label fw-semibold fs-6 mb-2 required">New Password</label>
                <div class="position-relative mb-3">
                  <input class="form-control form-control-lg form-control-solid" type="password" name="newpassword" required />
                </div>
                <div class="text-muted">Use 8 or more characters with a mix of letters, numbers & symbols.</div>
              </div>

              <div class="mb-10 fv-row" data-kt-password-meter="true">
                <label class="form-label fw-semibold fs-6 mb-2 required">Confirm New Password</label>
                <div class="position-relative mb-3">
                  <input class="form-control form-control-lg form-control-solid" type="password" name="comfirmpassword" required />
                </div>
              </div>

              <div class="text-center">
                <button type="submit" class="btn btn-lg btn-primary w-100 mb-5">
                  <span class="indicator-label">Update password</span>
                </button>
                <a href="" class="fw-semibold">Back to sign in</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const tokenField = document.getElementById('accessTokenInput');
    const status = document.getElementById('tokenStatus');

    function extractToken() {
      const hash = window.location.hash || '';
      const search = window.location.search || '';
      const params = new URLSearchParams(hash.startsWith('#') ? hash.slice(1) : hash);
      if (!params.get('access_token') && search) {
        const q = new URLSearchParams(search.startsWith('?') ? search.slice(1) : search);
        q.forEach((v, k) => params.set(k, v));
      }
      return params.get('access_token');
    }

    const token = extractToken() || tokenField.value;
    if (token) {
      tokenField.value = token;
      status.textContent = 'Reset link verified. Enter a new password.';
      status.classList.add('text-success');
    } else {
      status.textContent = 'Reset link missing or expired. Request a new one.';
      status.classList.add('text-danger');
    }
  })();
</script>

<%- include('../layouts/footer.ejs') %>
