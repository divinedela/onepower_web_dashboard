<%- include('../layouts/header.ejs') %>

<div class="d-flex flex-column flex-root" id="kt_app_root">
  <div class="d-flex flex-column flex-lg-row flex-column-fluid">
    <div class="d-flex flex-column flex-lg-row-auto bg-primary-info w-xl-600px positon-xl-relative">
      <div class="d-flex flex-column position-xl-fixed top-0 bottom-0 w-xl-600px scroll-y">
        <div class="d-flex flex-row-fluid flex-column text-center p-5 p-lg-10 pt-lg-20">
          <a class="py-2 py-lg-20">
            <img alt="Logo" src="assets/media/logos/image.png" class="h-90px h-lg-100px" />
          </a>
          <h1 class="d-none d-lg-block fw-bold text-white fs-2x pb-5 pb-md-10">
            Reset your password
          </h1>
          <p class="d-none d-lg-block fw-semibold fs-3 text-white">
            We will email you a reset link.
          </p>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column flex-lg-row-fluid py-10">
      <div class="d-flex flex-center flex-column flex-column-fluid">
        <div class="card">
          <div class="w-lg-600px p-10 p-lg-15 mx-auto">
            <form class="form w-100" method="post">
              <div class="text-center mb-10">
                <h1 class="text-dark mb-3">Forgot password</h1>
                <div class="text-gray-500 fw-semibold">Enter the admin email to receive a reset link.</div>
              </div>

              <% if(flash.error.length> 0){ %>
              <div class="alert alert-dismissible bg-light-danger d-flex align-items-center mb-10">
                <span class="fs-6 text-danger fw-bold text-center ps-5 fw-bolder"><%= flash.error %></span>
                <button type="button" class="btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                  <i class="ki-duotone ki-cross fs-1 text-danger fw-bold"><span class="path1"></span><span class="path2"></span></i>
                </button>
              </div>
              <% } %>

              <% if(flash.success.length> 0){ %>
              <div class="alert alert-dismissible bg-light-success d-flex align-items-center mb-10">
                <span class="fs-6 text-success fw-bold text-center ps-5 fw-bolder"><%= flash.success %></span>
                <button type="button" class="btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                  <i class="ki-duotone ki-cross fs-1 text-success fw-bold"><span class="path1"></span><span class="path2"></span></i>
                </button>
              </div>
              <% } %>

              <div class="fv-row mb-10">
                <label class="form-label fw-semibold fs-6 mb-2 required">Admin Email</label>
                <input class="form-control form-control-lg form-control-solid" type="email" name="email" required />
              </div>

              <div class="text-center">
                <button type="submit" class="btn btn-lg btn-primary w-100 mb-5">
                  <span class="indicator-label">Send reset link</span>
                </button>
                <a href="" class="fw-semibold">Back to sign in</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer.ejs') %>
